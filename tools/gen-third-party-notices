#!/usr/bin/env python3
"""Regenerate THIRD_PARTY_NOTICES.md from the vendored dependency tree.

Run from the repo root, or via `make notices`. Dependabot changes the
dependency set most weeks, so this is a generator rather than a file that is
edited by hand and silently goes stale.

Apache-2.0 section 4 requires retaining the license, copyright, and NOTICE
attributions of redistributed work. Vendoring means this repository
redistributes every module under vendor/, so the obligation is real rather
than decorative.
"""

import pathlib
import re
import sys

ROOT = pathlib.Path.cwd()
VENDOR = ROOT / "vendor"
MODULES = VENDOR / "modules.txt"
OUT = ROOT / "THIRD_PARTY_NOTICES.md"

LICENSE_NAMES = ("LICENSE", "LICENCE", "COPYING", "LICENSE.md", "LICENSE.txt")

# Ordered: the first match wins, so more specific patterns come first.
DETECTORS = [
    ("Apache-2.0", re.compile(r"Apache License\s*\n?\s*Version 2\.0", re.I)),
    ("MPL-2.0", re.compile(r"Mozilla Public License Version 2\.0", re.I)),
    ("ISC", re.compile(r"Permission to use, copy, modify, and/or distribute", re.I)),
    ("BSD-3-Clause", re.compile(r"Redistribution and use.*?Neither the name", re.I | re.S)),
    ("BSD-2-Clause", re.compile(r"Redistribution and use in source and binary forms", re.I)),
    ("MIT", re.compile(r"Permission is hereby granted, free of charge", re.I)),
]


def detect(text):
    for name, pat in DETECTORS:
        if pat.search(text):
            return name
    return "See license text"


def find_license(module_dir):
    """Walk up from the module directory: some modules license at the repo root."""
    d = module_dir
    while d != VENDOR and d.is_relative_to(VENDOR):
        for name in LICENSE_NAMES:
            p = d / name
            if p.is_file():
                return p
        d = d.parent
    return None


def main():
    if not MODULES.is_file():
        sys.exit(f"no {MODULES} -- run from the repo root, after `make tidy`")

    modules = []
    for line in MODULES.read_text().splitlines():
        if line.startswith("# ") and not line.startswith("## "):
            parts = line[2:].split()
            if len(parts) >= 2:
                modules.append((parts[0], parts[1]))
    modules.sort()

    rows, texts, notices, missing = [], {}, [], []
    for path, version in modules:
        lic = find_license(VENDOR / path)
        if lic is None:
            missing.append(path)
            rows.append((path, version, "not found"))
            continue
        body = lic.read_text(errors="replace")
        ident = detect(body)
        rows.append((path, version, ident))
        texts.setdefault(ident, (path, body))

        for nname in ("NOTICE", "NOTICE.txt", "NOTICE.md"):
            n = lic.parent / nname
            if n.is_file():
                notices.append((path, n.read_text(errors="replace").strip()))
                break

    out = []
    out.append("# Third-party notices\n")
    out.append(
        "This project redistributes the Go modules listed below in the `vendor/`\n"
        "directory. Their licenses and attributions are reproduced here as required.\n"
    )
    out.append(
        "\n> Generated by `tools/gen-third-party-notices`. Do not edit by hand --\n"
        "> run `make notices` after changing dependencies.\n"
    )
    out.append(f"\n## Dependencies ({len(rows)})\n")
    out.append("| Module | Version | License |")
    out.append("|---|---|---|")
    for path, version, ident in rows:
        out.append(f"| `{path}` | {version} | {ident} |")

    if notices:
        out.append("\n## NOTICE files\n")
        out.append(
            "Reproduced verbatim, as required by Apache-2.0 section 4(d).\n"
        )
        for path, body in sorted(notices):
            out.append(f"\n### `{path}`\n\n```\n{body}\n```")

    out.append("\n## License texts\n")
    out.append(
        "One copy of each distinct license, with a representative module named.\n"
        "The full text as shipped is in that module's directory under `vendor/`.\n"
    )
    for ident in sorted(texts):
        rep, body = texts[ident]
        out.append(f"\n### {ident}\n\nRepresentative module: `{rep}`\n")
        out.append(f"```\n{body.strip()}\n```")

    OUT.write_text("\n".join(out) + "\n")

    print(f"wrote {OUT.relative_to(ROOT)}: {len(rows)} modules, "
          f"{len(texts)} distinct licenses, {len(notices)} NOTICE files")
    if missing:
        print(f"WARNING: no license file found for {len(missing)} module(s):", file=sys.stderr)
        for m in missing:
            print(f"  {m}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
