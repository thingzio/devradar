#!/bin/bash
set -euo pipefail

# Sets the GitHub Actions 'saas' environment variables the release/deploy
# workflows need, reading them straight from Terraform outputs — so you never
# hand-copy values from `terraform output` into the GitHub UI.
#
# Run from the repo root AFTER `make tf-apply`.
#
# Prerequisites:
#   - gh CLI authenticated (gh auth status)
#   - terraform apply completed in infra/saas/
#
# The four variables (WIF_PROVIDER, DEPLOYER_SA, REGION, PROJECT_ID) are what
# .github/workflows/{release,deploy}.yaml consume for keyless (WIF) deploys.

REPO="thingzio/devradar"
ENV_NAME="saas"
TF_DIR="infra/saas"

command -v gh >/dev/null 2>&1 || { echo "error: gh CLI not found" >&2; exit 1; }
command -v terraform >/dev/null 2>&1 || { echo "error: terraform not found" >&2; exit 1; }

echo "==> Reading Terraform outputs from ${TF_DIR}..."
WIF_PROVIDER=$(terraform -chdir="$TF_DIR" output -raw wif_provider)
DEPLOYER_SA=$(terraform -chdir="$TF_DIR" output -raw deployer_sa)
REGION=$(terraform -chdir="$TF_DIR" output -raw region)
PROJECT_ID=$(terraform -chdir="$TF_DIR" output -raw project_id)

# Ensure the environment exists (idempotent). gh has no dedicated "create env"
# command, so use the REST API; ignore the response body.
echo "==> Ensuring '${ENV_NAME}' environment exists on ${REPO}..."
gh api -X PUT "repos/${REPO}/environments/${ENV_NAME}" >/dev/null

echo "==> Setting variables for '${ENV_NAME}'..."
gh variable set WIF_PROVIDER --repo "$REPO" --env "$ENV_NAME" --body "$WIF_PROVIDER"
gh variable set DEPLOYER_SA  --repo "$REPO" --env "$ENV_NAME" --body "$DEPLOYER_SA"
gh variable set REGION       --repo "$REPO" --env "$ENV_NAME" --body "$REGION"
gh variable set PROJECT_ID   --repo "$REPO" --env "$ENV_NAME" --body "$PROJECT_ID"

echo ""
echo "==> Done. '${ENV_NAME}' environment variables:"
echo "  WIF_PROVIDER = ${WIF_PROVIDER}"
echo "  DEPLOYER_SA  = ${DEPLOYER_SA}"
echo "  REGION       = ${REGION}"
echo "  PROJECT_ID   = ${PROJECT_ID}"
echo ""
echo "Next: tag a release (git tag vX.Y.Z && git push origin vX.Y.Z) to build + deploy."
