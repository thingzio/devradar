#!/usr/bin/env bash
#
# Guards the deployment contract.
#
# The rollout mechanics -- pause, three ordered updates, resume, per-command
# timeouts, digest validation -- moved into the shared thingzio/actions
# deploy-cloud-run workflow, which unit tests them with gcloud stubbed. This
# file no longer re-checks them by grepping for command strings, because those
# strings are no longer here and asserting on another repository's internals
# through a pinned SHA would be checking a copy.
#
# What remains here is what is still this repository's to get right:
#
#   * the images are built by SHA-pinned shared build definitions
#   * the release passes each image straight from its build job, never a tag
#   * the deploy names the right resources, in the order that keeps a partial
#     rollout safe
#   * the scheduler is held for the rollout, fail-closed, as DEPLOYMENT.md says
#   * no rollback path, no defaults on image inputs, no mutable references
#   * the runbook still describes what the workflow actually does

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
workflow="$root/.github/workflows/deploy.yaml"
release_workflow="$root/.github/workflows/release.yaml"
runbook="$root/DEPLOYMENT.md"

fail() {
  echo "deploy workflow check: $*" >&2
  exit 1
}

count_fixed() {
  local file="$1" pattern="$2" count
  count=$(grep -cF "$pattern" "$file" || true)
  printf '%s\n' "${count:-0}"
}

# --- release job ------------------------------------------------------------

release_section=$(awk '
  /^  release:/{emit=1}
  emit && /^  deploy:/{exit}
  emit
' "$release_workflow")

# Binaries come from the shared release definition, SHA-pinned like the images.
# The Sigstore identity a consumer verifies against names that workflow and its
# ref, so a tag would let the definition change under a release claiming it.
#
# This replaces a timeout-minutes assertion. A job that calls a reusable
# workflow cannot carry one, and release-go sets its own per-job timeouts --
# 45 minutes on the job that runs goreleaser, which is the one that used to
# need the 60 asserted here.
printf '%s\n' "$release_section" |
  grep -qE 'uses: thingzio/actions/\.github/workflows/release-go\.yaml@[0-9a-f]{40}' ||
  fail "binaries must be released by the SHA-pinned shared release definition"

# publish: false is the entire reason the publish job exists. Without it
# release-go publishes as soon as it has signed, and a failed deploy leaves a
# visible release naming images nobody is serving -- the property this file is
# here to protect.
printf '%s\n' "$release_section" | grep -qE '^      publish: false$' ||
  fail "release must leave the draft for the publish job to flip after deploy"

# And the flip has to actually be gated on the deploy.
awk '/^  publish:/{emit=1} emit' "$release_workflow" | grep -qE '^      - deploy$' ||
  fail "publish must be gated on deploy"

# Pinning by SHA is what makes the SLSA provenance builder.id immutable; a tag
# or branch ref would let the build definition change under a release that
# claims it.
test "$(grep -cE 'uses: thingzio/actions/\.github/workflows/build-(ko|docker)\.yaml@[0-9a-f]{40}' "$release_workflow" || true)" -eq 3 ||
  fail "all three images must be built by SHA-pinned shared build definitions"

# --- deploy wrapper ---------------------------------------------------------

# The deploy definition itself must be SHA-pinned for the same reason.
test "$(grep -cE 'uses: thingzio/actions/\.github/workflows/deploy-cloud-run\.yaml@[0-9a-f]{40}' "$workflow" || true)" -eq 1 ||
  fail "deploy must call a SHA-pinned shared deploy definition"

if grep -qiE 'image_tag|:latest|artifacts docker images describe' "$workflow"; then
  fail "deploy must accept immutable images without resolving tags"
fi
if grep -qE '^        default:' "$workflow"; then
  fail "manual immutable image inputs must not have defaults"
fi
if grep -qiE 'rollback|recover|upload-artifact|download-artifact|workflow_run|--async' "$workflow"; then
  fail "workflow must be forward-only with no rollback/recovery path"
fi
if test -e "$root/.github/workflows/deploy-recover.yaml"; then
  fail "abandoned recovery workflow still exists"
fi

for image in delivery scan serve; do
  case "$image" in
    delivery) job='build-deliver'; resource='job=devradar-saas-deliver' ;;
    scan) job='build-scan'; resource='job=devradar-saas-scan' ;;
    serve) job='build-serve'; resource='service=devradar-saas-serve' ;;
  esac
  # Required by both the reusable and the manual trigger.
  test "$(grep -cE "^      ${image}_image:\$" "$workflow" || true)" -eq 2 ||
    fail "${image} image must be required by reusable and manual triggers"
  # The digest comes from the build job that produced it, not a registry lookup
  # after the fact: a lookup resolves whatever the tag points at when it runs,
  # while the build output is the digest that was just published.
  test "$(count_fixed "$release_workflow" "${image}_image: \${{ needs.${job}.outputs.image_ref }}")" -eq 1 ||
    fail "release must pass the ${image} image straight from its build job"
  # Each image reaches the right resource, by name.
  test "$(count_fixed "$workflow" "${resource}=\${{ inputs.${image}_image }}")" -eq 1 ||
    fail "${image} image must be mapped to ${resource}"
done

test "$(grep -cE '^        required: true$' "$workflow" || true)" -eq 6 ||
  fail "all reusable and manual image inputs must be required"

# Order is the safety property. Delivery consumes outbox rows produced by serve,
# so the backward-compatible consumer is updated before the producer. That makes
# every prefix of a partial rollout safe, which is what lets a failed deploy be
# recovered forward rather than rolled back.
targets=$(awk '/^      targets: \|/{emit=1; next} emit && /^      [a-z_]+:/{exit} emit' "$workflow")
delivery_line=$(printf '%s\n' "$targets" | grep -n 'devradar-saas-deliver=' | head -1 | cut -d: -f1)
scan_line=$(printf '%s\n' "$targets" | grep -n 'devradar-saas-scan=' | head -1 | cut -d: -f1)
serve_line=$(printf '%s\n' "$targets" | grep -n 'devradar-saas-serve=' | head -1 | cut -d: -f1)
[[ -n "$delivery_line" && -n "$scan_line" && -n "$serve_line" ]] ||
  fail "deploy targets must name delivery, scan and serve"
(( delivery_line < scan_line && scan_line < serve_line )) ||
  fail "deploy order must be delivery, scan, serve"

# The scheduler is held for the rollout, and left paused on failure. This is the
# promise DEPLOYMENT.md makes to an operator; the shared workflow defaults the
# other way, so the opt-out has to be explicit and has to stay.
grep -qE '^      scheduler_job: devradar-saas-deliver-scheduled$' "$workflow" ||
  fail "delivery schedule must be held for the rollout"
grep -qE '^      resume_on_failure: false$' "$workflow" ||
  fail "deploy must stay fail-closed: a failed rollout leaves delivery paused"

# --- runbook ----------------------------------------------------------------

grep -qE 'leaves delivery paused' "$runbook" || fail "runbook does not document fail-closed paused state"
grep -qE 'workflow_dispatch' "$runbook" || fail "runbook does not document idempotent operator rerun"
grep -qE 'inspect both the Scheduler state' "$runbook" || fail "runbook does not require Scheduler inspection"
grep -qE 'exact image references' "$runbook" || fail "runbook does not require image inspection"
tr '\n' ' ' < "$runbook" | grep -qE 'Never manually resume the[[:space:]]+Scheduler after a partial image' ||
  fail "runbook permits manual resume after partial mutation"
if grep -qiE 'to that tag|Manual redeploy of an existing tag|re-point to.*latest' "$runbook"; then
  fail "runbook still documents mutable-tag deployment"
fi
for input in delivery_image scan_image serve_image; do
  grep -qF "\`${input}\`" "$runbook" || fail "runbook omits manual ${input} input"
done

echo "deploy workflow check: PASS (fail-closed, order delivery→scan→serve)"
