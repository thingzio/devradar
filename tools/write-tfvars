#!/bin/bash
set -euo pipefail

# Writes infra/run/terraform.tfvars from the environment.
#
# Run from the repo root BEFORE `make tf-plan` or `make tf-apply`.
#
# Why this exists: variables.tf deliberately gives no default to any value that
# identifies a specific deployment -- the GCP project, the domain, the shared
# network and database, the operator allowlist, and the two secrets. Terraform
# therefore refuses to plan without a tfvars rather than silently falling back
# to someone else's identifiers, and an absent tfvars can no longer be read as
# "the source of truth says empty" and overwrite a live secret with a
# placeholder.
#
# The defaults below are the maintainer's reference instance. Override any of
# them through the environment to point at your own deployment.
#
# Required in the environment (no sensible default exists):
#   TF_VAR_github_oauth_client_secret   GitHub OAuth app client secret
#   TF_VAR_anthropic_api_key            Anthropic API key
#
# Both accept the literal string "none" to mean "write the placeholder and
# leave the feature off" -- an explicit opt-out rather than an accidental one.
#
# Terraform also reads TF_VAR_* directly, so exporting all of these is enough
# for a one-off plan. The file is for durability across shells; it is gitignored
# by the *.tfvars rule and written 0600.

TF_DIR="infra/run"
OUT="${TF_DIR}/terraform.tfvars"

if [[ ! -d "$TF_DIR" ]]; then
  echo "ERROR: run from the repo root (no ${TF_DIR}/ here)." >&2
  exit 1
fi

missing=()
[[ -n "${TF_VAR_github_oauth_client_secret:-}" ]] || missing+=("TF_VAR_github_oauth_client_secret")
[[ -n "${TF_VAR_anthropic_api_key:-}" ]] || missing+=("TF_VAR_anthropic_api_key")

if (( ${#missing[@]} > 0 )); then
  echo "ERROR: refusing to write a partial ${OUT}." >&2
  echo "       A missing secret would be written as a placeholder over the live value." >&2
  echo "" >&2
  echo "Set these and re-run (use the literal 'none' to opt out of a feature):" >&2
  printf '  export %s=...\n' "${missing[@]}" >&2
  exit 1
fi

# "none" is the explicit opt-out; it becomes an empty string, which secrets.tf
# turns into the documented placeholder.
oauth_secret="${TF_VAR_github_oauth_client_secret}"
anthropic_key="${TF_VAR_anthropic_api_key}"
[[ "$oauth_secret" == "none" ]] && oauth_secret=""
[[ "$anthropic_key" == "none" ]] && anthropic_key=""

# Deployment identity. Defaults are the maintainer's reference instance.
project_id="${TF_VAR_project_id:-thingzio}"
domain="${TF_VAR_domain:-devradar.thingz.io}"
git_repo="${TF_VAR_git_repo:-thingzio/devradar}"
notification_email="${TF_VAR_notification_email:-devradar@thingz.io}"
email_from="${TF_VAR_email_from:-DevRadar <no-reply@thingz.io>}"

# Shared infrastructure, owned by the private thingzio/infra repo and referenced
# here rather than created. A self-hoster points these at their own.
vpc_id="${TF_VAR_vpc_id:-projects/thingzio/global/networks/thingzio-vpc}"
subnet_id="${TF_VAR_subnet_id:-projects/thingzio/regions/us-west1/subnetworks/thingzio-subnet}"
db_instance_name="${TF_VAR_db_instance_name:-thingzio-pg}"
db_connection_name="${TF_VAR_db_connection_name:-thingzio:us-west1:thingzio-pg}"
db_name="${TF_VAR_db_name:-thingz}"

# Application configuration.
client_id="${TF_VAR_github_oauth_client_id:-Ov23liM8duaiBKQ43Lc8}"
admins="${TF_VAR_admin_users:-mark@chmarny.com}"
sharing="${TF_VAR_account_sharing_enabled:-true}"

if [[ -e "$OUT" ]]; then
  # Backup name ends in .tfvars so the existing *.tfvars gitignore rule covers
  # it. Naming it terraform.tfvars.<ts>.bak would NOT match that glob, leaving a
  # file full of live secrets committable.
  backup="${TF_DIR}/terraform.backup-$(date +%Y%m%d-%H%M%S).tfvars"
  cp -p "$OUT" "$backup"
  echo "==> Existing file backed up to ${backup}"
fi

umask 077
cat > "$OUT" <<EOF
# Generated by tools/write-tfvars on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Gitignored (*.tfvars). Never commit this file.

# --- Deployment identity ---
project_id         = "${project_id}"
domain             = "${domain}"
git_repo           = "${git_repo}"
notification_email = "${notification_email}"
email_from         = "${email_from}"

# --- Shared infrastructure (referenced, not created here) ---
vpc_id             = "${vpc_id}"
subnet_id          = "${subnet_id}"
db_instance_name   = "${db_instance_name}"
db_connection_name = "${db_connection_name}"
db_name            = "${db_name}"

# --- Application ---
github_oauth_client_id     = "${client_id}"
github_oauth_client_secret = "${oauth_secret}"
anthropic_api_key          = "${anthropic_key}"
admin_users                = "${admins}"
account_sharing_enabled    = ${sharing}
EOF
chmod 600 "$OUT"

echo "==> Wrote ${OUT} (0600)"
echo "    project_id                 = ${project_id}"
echo "    domain                     = ${domain}"
echo "    github_oauth_client_id     = ${client_id}"
echo "    github_oauth_client_secret = <${#oauth_secret} chars>"
echo "    anthropic_api_key          = <${#anthropic_key} chars>"
echo "    admin_users                = ${admins}"
echo "    account_sharing_enabled    = ${sharing}"
echo ""
echo "Next: make tf-plan  # expect no changes against the live instance"
