#!/bin/bash
set -euo pipefail

# Writes infra/run/terraform.tfvars from the environment.
#
# Run from the repo root BEFORE `make tf-plan` or `make tf-apply`.
#
# Why this exists: variables.tf gives github_oauth_client_secret and
# anthropic_api_key an empty-string default, and secrets.tf turns an empty
# value into the literal "placeholder-set-real-value-out-of-band". So applying
# without a tfvars does not fail -- it overwrites the live secret versions with
# placeholders and empties the Cloud Run env. This script refuses to write a
# partial file so that failure mode stays unreachable.
#
# Required in the environment:
#   TF_VAR_github_oauth_client_secret   GitHub OAuth app client secret
#   TF_VAR_anthropic_api_key            Anthropic API key
#
# Optional (defaults below match the deployed reference instance):
#   TF_VAR_github_oauth_client_id
#   TF_VAR_admin_users
#   TF_VAR_account_sharing_enabled
#
# Terraform also reads TF_VAR_* directly, so exporting these is enough for a
# one-off plan. The file is for durability across shells; it is gitignored by
# the *.tfvars rule and written 0600.

TF_DIR="infra/run"
OUT="${TF_DIR}/terraform.tfvars"

if [[ ! -d "$TF_DIR" ]]; then
  echo "ERROR: run from the repo root (no ${TF_DIR}/ here)." >&2
  exit 1
fi

missing=()
[[ -n "${TF_VAR_github_oauth_client_secret:-}" ]] || missing+=("TF_VAR_github_oauth_client_secret")
[[ -n "${TF_VAR_anthropic_api_key:-}" ]] || missing+=("TF_VAR_anthropic_api_key")

if (( ${#missing[@]} > 0 )); then
  echo "ERROR: refusing to write a partial ${OUT}." >&2
  echo "       An empty secret becomes a placeholder that overwrites the live value." >&2
  echo "" >&2
  echo "Set these and re-run:" >&2
  printf '  export %s=...\n' "${missing[@]}" >&2
  exit 1
fi

# Non-secret values. Defaults are the deployed reference instance, overridable.
client_id="${TF_VAR_github_oauth_client_id:-Ov23liM8duaiBKQ43Lc8}"
admins="${TF_VAR_admin_users:-mark@chmarny.com}"
sharing="${TF_VAR_account_sharing_enabled:-true}"

if [[ -e "$OUT" ]]; then
  # Backup name ends in .tfvars so the existing *.tfvars gitignore rule covers
  # it. Naming it terraform.tfvars.<ts>.bak would NOT match that glob, leaving a
  # file full of live secrets committable.
  backup="${TF_DIR}/terraform.backup-$(date +%Y%m%d-%H%M%S).tfvars"
  cp -p "$OUT" "$backup"
  echo "==> Existing file backed up to ${backup}"
fi

umask 077
cat > "$OUT" <<EOF
# Generated by tools/write-tfvars on $(date -u +%Y-%m-%dT%H:%M:%SZ).
# Gitignored (*.tfvars). Never commit this file.

github_oauth_client_id     = "${client_id}"
github_oauth_client_secret = "${TF_VAR_github_oauth_client_secret}"
anthropic_api_key          = "${TF_VAR_anthropic_api_key}"
admin_users                = "${admins}"
account_sharing_enabled    = ${sharing}
EOF
chmod 600 "$OUT"

echo "==> Wrote ${OUT} (0600)"
echo "    github_oauth_client_id     = ${client_id}"
echo "    github_oauth_client_secret = <set, ${#TF_VAR_github_oauth_client_secret} chars>"
echo "    anthropic_api_key          = <set, ${#TF_VAR_anthropic_api_key} chars>"
echo "    admin_users                = ${admins}"
echo "    account_sharing_enabled    = ${sharing}"
echo ""
echo "Next: make tf-plan  # expect no changes against the live instance"
