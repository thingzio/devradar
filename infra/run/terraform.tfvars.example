# Copy to terraform.tfvars and fill in, or run tools/write-tfvars to generate
# it from TF_VAR_* environment variables. terraform.tfvars is gitignored.
#
# WARNING: do not apply with these variables unset. variables.tf defaults them
# to "", and secrets.tf turns "" into the literal placeholder
# "placeholder-set-real-value-out-of-band" -- so an apply without real values
# does not fail, it overwrites the live secret versions and empties the Cloud
# Run environment.

# GitHub OAuth app credentials. Register your own app at
# https://github.com/settings/developers with the callback set to
# https://<your domain>/auth/github/callback
github_oauth_client_id     = ""
github_oauth_client_secret = ""

# Anthropic API key. Self-hosters bring their own; AI cost scales to whoever
# runs the instance.
anthropic_api_key = ""

# Comma-separated emails granted admin access.
admin_users = ""

# Whether tenants may share account access with other users.
account_sharing_enabled = false

# Everything else -- project_id, region, prefix, domain, git_repo, database and
# network identifiers -- is defaulted in variables.tf to the values of the
# reference instance run by the maintainer. Override whichever ones differ for
# your deployment; see DEPLOYMENT.md.
