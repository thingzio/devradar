# Copy to terraform.tfvars and fill in, or run tools/write-tfvars to generate it
# from TF_VAR_* environment variables. terraform.tfvars is gitignored.
#
# Every variable below is REQUIRED -- variables.tf gives none of them a default,
# on purpose. Anything that identifies a particular deployment has to be stated
# rather than inherited, so Terraform cannot silently point at the maintainer's
# project, and an absent tfvars cannot be read as "empty" and overwrite a live
# secret with a placeholder. Terraform refuses to plan until these are set.
#
# Variables NOT listed here keep sensible generic defaults: region, prefix,
# bootstrap_image, scan_schedule, scan_max_age, account_sharing_enabled, and
# db_user. Override any of them if you need to; see variables.tf.

# --- Deployment identity ---

# GCP project that will hold the Cloud Run services, secrets, and registry.
project_id = ""

# Public domain the service is served from.
domain = ""

# GitHub repository, used to scope Workload Identity Federation so only this
# repo's workflows can deploy. Format: owner/name.
git_repo = ""

# Where infrastructure alerts are sent.
notification_email = ""

# From address for outbound magic-link email. Must sit under a domain verified
# with your email provider.
email_from = "DevRadar <no-reply@example.com>"

# --- Shared infrastructure ---
#
# These are referenced, never created by this configuration. Point them at
# network and database resources you already own. The maintainer's live in a
# separate private repository, which is why nothing here creates them.

vpc_id             = ""
subnet_id          = ""
db_instance_name   = ""
db_connection_name = ""  # project:region:instance
db_name            = ""

# --- Application ---

# GitHub OAuth app for UI sign-in. Register your own at
# https://github.com/settings/developers with the callback set to
# https://<your domain>/auth/github/callback
#
# The client ID is a public identifier. The secret is not: it flows into Secret
# Manager. Set both to an empty string to disable GitHub sign-in and fall back
# to email-only magic links.
github_oauth_client_id     = ""
github_oauth_client_secret = ""

# Anthropic API key for the admin AI health summary. Self-hosters bring their
# own, so AI cost scales to whoever runs the instance. An empty string keeps the
# placeholder: the summary stays off and raw metrics still render.
anthropic_api_key = ""

# Comma-separated emails allowed into the /admin console. An empty string hides
# it completely -- every /admin route returns 404.
admin_users = ""

# Account invitations and membership management.
account_sharing_enabled = false
